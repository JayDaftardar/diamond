# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/diamond
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]
COOKIE_DOMAIN=
COOKIE_SECURE=false
APP_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development

# Exactly two admin accounts, created by scripts/seed_admins.py (password min 12 chars).
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
