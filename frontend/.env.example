# Server-side only: how the SSR server reaches the API.
API_INTERNAL_URL=http://localhost:8000

# Exposed to the browser (VITE_ prefix). Public site address, used for canonical links,
# Open Graph and the sitemap.
VITE_SITE_URL=http://localhost:3000
# How the visitor's browser reaches the API (contact form, admin panel).
VITE_API_PUBLIC_URL=http://localhost:8000
# Google Maps embed link: Maps > Share > Embed a map > copy the src value.
# Leave empty to use a generic search embed until the real one is supplied.
VITE_MAP_EMBED_URL=
